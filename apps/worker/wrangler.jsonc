{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "codra",
  "main": "./src/index.ts",
  "compatibility_date": "2026-04-16",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "codra.iteractive.dev",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
    },
  },
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "c677cfc10d064834bf2689be2ab20d19",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "APP_KV",
      "id": "59f856874a7c44899f0154711940f3b5",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "REVIEW_QUEUE",
        "queue": "codra-review-jobs",
      },
    ],
    "consumers": [
      {
        "queue": "codra-review-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_concurrency": 1,
        "retry_delay": 60,
        "max_retries": 3,
      },
    ],
  },
  "workflows": [
    {
      "name": "codra-review-workflow",
      "binding": "REVIEW_WORKFLOW",
      "class_name": "ReviewWorkflow",
    },
  ],
  "triggers": {
    "crons": ["*/2 * * * *"],
  },
  "assets": {
    "directory": "../../dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/dashboard*",
      "/jobs*",
      "/repos*",
      "/stats*",
      "/health*",
      "/api/*",
      "/auth/*",
      "/webhook*",
      "/settings*",
      "/account*",
    ],
  },
  "secrets": {
    "required": [
      "APP_PRIVATE_KEY",
      "GITHUB_APP_ID",
      "GITHUB_APP_WEBHOOK_SECRET",
      "GITHUB_CLIENT_ID",
      "GITHUB_CLIENT_SECRET",
      "LLM_CONFIG_ENCRYPTION_KEY",
      "CF_ACCOUNT_ID",
    ],
  },
  "vars": {
    "APP_URL": "https://codra.iteractive.dev",
    "AUTH_CALLBACK_URL": "https://codra.iteractive.dev/auth/github/callback",
    "BOT_USERNAME": "codra-iteractive",
    "GITHUB_APP_SLUG": "codra-iteractive",
    "DASHBOARD_ALLOWED_USERS": "bradhallett",
    "ENVIRONMENT": "production",
    "TELEMETRY_DISABLED": "true",
  },
}
